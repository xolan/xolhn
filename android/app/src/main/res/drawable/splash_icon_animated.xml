<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="badge_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.72"
                android:scaleY="0.72">
                <path
                    android:name="badge_path"
                    android:fillAlpha="0"
                    android:fillColor="#FF6B1A"
                    android:pathData="M41,30H67A11,11 0 0,1 78,41V67A11,11 0 0,1 67,78H41A11,11 0 0,1 30,67V41A11,11 0 0,1 41,30Z" />
                <path
                    android:name="x_stroke_1"
                    android:pathData="M44,41L64,67"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="6"
                    android:trimPathEnd="0" />
                <path
                    android:name="x_stroke_2"
                    android:pathData="M64,41L44,67"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeWidth="6"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="badge_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="260"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.72"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="badge_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="180"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="x_stroke_1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="140"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="x_stroke_2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="240"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

</animated-vector>
